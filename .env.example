# ---------------------------------------------------------------------------
# eval-platform configuration. Copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# Application
APP_ENV=local
LOG_LEVEL=INFO
API_KEY=change-me
CORS_ORIGINS=*
RATE_LIMIT=60/minute

# PostgreSQL (databases dedicated to this project)
PGHOST=localhost
PGPORT=5432
PGDATABASE=eval_platform
PGUSER=evalorches
PGPASSWORD=evalorches
PGSCHEMA=public

# Optional full URL override. When set it wins over the PG* variables.
# DATABASE_URL=postgresql://evalorches:evalorches@localhost:5432/eval_platform

# Test database, used by pytest only.
TEST_PGDATABASE=eval_platform_test

# Connection pool
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=20
DB_CONNECT_TIMEOUT=10

# Temporary dataset input. dataset_id is a folder name under this root.
# Payloads are read from here at job creation and at evaluation time; they are
# not stored in PostgreSQL.
EVALUATION_TEMP_ROOT=./temp

# Runner
RUNNER_POLL_INTERVAL_SECONDS=2.0
RUNNER_CLAIM_BATCH_SIZE=5
RUNNER_MAX_CONCURRENCY=4
RUNNER_LEASE_SECONDS=300
RUNNER_TICKET_TIMEOUT_SECONDS=120
RUNNER_MAX_ATTEMPTS=3
RUNNER_RETRY_BACKOFF_SECONDS=30,60,120
RUNNER_RECOVERY_INTERVAL_SECONDS=60
RUNNER_SHUTDOWN_GRACE_SECONDS=180

# LLM providers. Configure at least one for LLM judge checks.
DEFAULT_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Evaluation defaults
DEFAULT_ON_MISSING_CONTEXT=not_applicable
SEMANTIC_THRESHOLD=0.75
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
INPUT_COST_PER_1M=0.15
OUTPUT_COST_PER_1M=0.60
